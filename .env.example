# ── Application ───────────────────────────────────────────────────────────────
SECRET_KEY=change_me_min_32_chars_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=school_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@postgres:5432/school_erp

